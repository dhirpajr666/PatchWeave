{
  "release": "2026.09-checkout",
  "requirements": [
    {
      "id": "REQ-CHK-1",
      "title": "Checkout sessions must be idempotent under client retries",
      "risk": "critical",
      "owner": "dana",
      "globs": ["src/checkout/*.py"]
    },
    {
      "id": "REQ-CHK-2",
      "title": "Retry storms must not double-charge a customer",
      "risk": "critical",
      "owner": "dana",
      "globs": ["src/checkout/retry.py", "src/payments/*.py"]
    },
    {
      "id": "REQ-PAY-9",
      "title": "Ledger writes are append-only and monotonically versioned",
      "risk": "elevated",
      "owner": "omar",
      "globs": ["src/payments/ledger.py"]
    },
    {
      "id": "REQ-DOC-4",
      "title": "Checkout flow documentation reflects the idempotency contract",
      "risk": "routine",
      "owner": "lin",
      "globs": ["docs/*.md"]
    },
    {
      "id": "REQ-OBS-7",
      "title": "Idempotency-key collisions emit a structured warning metric",
      "risk": "notable",
      "owner": "priya",
      "globs": ["src/observability/*.py"]
    }
  ]
}
